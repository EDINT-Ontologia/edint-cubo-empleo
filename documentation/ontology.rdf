    <owl:ObjectProperty rdf:about="http://vocab.linkeddata.es/datosabiertos/def/dimension#age">
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
    </owl:ObjectProperty>
    


    <!-- http://vocab.linkeddata.es/datosabiertos/def/dimension#contractType -->


    <owl:ObjectProperty rdf:about="http://vocab.linkeddata.es/datosabiertos/def/dimension#contractType">
        <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    </owl:ObjectProperty>
    


    <!-- http://vocab.linkeddata.es/datosabiertos/def/dimension#economicActivity -->


