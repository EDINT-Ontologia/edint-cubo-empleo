@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix qb: <http://purl.org/linked-data/cube#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix edintemp: <https://edint.es/def/cubo-empleo#> .
@prefix edintdimension: <http://vocab.linkeddata.es/datosabiertos/def/dimension#> .
@prefix edintmeasure: <http://vocab.linkeddata.es/datosabiertos/def/measure#> .
@prefix edintcontracttype: <https://edint.es/kos/EmploymentContractType/> .
@prefix ine: <https://lod.ine.es/def/vocabulary/> .
@prefix edintkos: <https://edint.es/kos/> .
@prefix esadm: <http://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio#> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct: <http://purl.org/dc/terms/> .

#######################################################################
#  Ontologia (reutilizada del repositorio)
#######################################################################

<https://edint.es/def/cubo-empleo>
    a owl:Ontology ;
    owl:imports <http://purl.org/linked-data/cube> ;
    owl:versionInfo "0.1.0" .

#######################################################################
#  Data Set y Data Structure Definition
#######################################################################

<https://edint.es/def/cubo-empleo#> a qb:DataSet ;
    dct:title "Cubo de indicadores de empleo"@es ,
              "Employment indicators data cube"@en ;
    qb:structure edintemp:dsd .

edintemp:dsd a qb:DataStructureDefinition ;
    qb:component
        [ qb:dimension edintdimension:refAdminRegion ; qb:order 1 ] ,
        [ qb:dimension edintdimension:sector ; qb:order 2 ] ,
        [ qb:dimension edintdimension:economicActivity ; qb:order 3 ] ,
        [ qb:dimension edintdimension:refPeriod ; qb:order 4 ] ,
        [ qb:dimension edintdimension:sex ; qb:order 5 ] ,
        [ qb:dimension edintdimension:age ; qb:order 6 ] ,
        [ qb:dimension edintdimension:contractType ; qb:order 7 ] ,
        [ qb:measure edintmeasure:activePopulationCount ; qb:order 8 ] ,
        [ qb:measure edintmeasure:employedPopulationCount ; qb:order 9 ] ,
        [ qb:measure edintmeasure:unemployedPopulationCount ; qb:order 10 ] ,
        [ qb:measure edintmeasure:registeredContractsCount ; qb:order 11 ] ,
        [ qb:measure edintmeasure:jobSeekersCount ; qb:order 12 ] ,
        [ qb:measure edintmeasure:registeredUnemploymentCount ; qb:order 13 ] ,
        [ qb:measure edintmeasure:socialSecurityAffiliatesCount ; qb:order 14 ] ,
        [ qb:measure ine:unemploymentRate ; qb:order 15 ] ,
        [ qb:measure ine:employmentRate ; qb:order 16 ] ,
        [ qb:measure ine:jobs ; qb:order 17 ] ,
        [ qb:measure edintmeasure:jobProfiles ; qb:order 18 ] ,
        [ qb:measure ine:numberOfPeople ; qb:order 19 ] .

#######################################################################
#  Observaciones de ejemplo
#
#  Cobertura de datos por combinacion region x trimestre:
#    Aragon:       Q1 2024, Q2 2024
#    Zaragoza:     Q1 2024, Q2 2024
#    Huesca:       Q1 2024
#
#  Cada observacion incluye TODAS las dimensiones y medidas del DSD.
#  Se usan valores numericos ficticios para que las 14 consultas
#  devuelvan filas.
#######################################################################

# -------------------------------------------------------------------
#  Aragon - Q1 2024
# -------------------------------------------------------------------

edintemp:obs_aragon-Q12024 a qb:Observation ;
    qb:dataSet <https://edint.es/def/cubo-empleo#> ;
    qb:structure         edintemp:dsd ;

    # --- dimensiones ---
    edintdimension:refAdminRegion <http://id.ine.es/inegm/zona/98076> ;
    edintdimension:sector       <http://datos.gob.es/kos/sector-publico/sector/empleo> ;
    edintdimension:economicActivity <http://lod.ine.es/kos/cnae/CNAE-2025/section/a> ;
    edintdimension:refPeriod    <http://id.ine.es/recurso/time-interval/P2024-Q1> ;
    edintdimension:sex          <http://id.ine.es/dato/sexo/1> ;
    edintdimension:age          <http://id.ine.es/dato/edad/25-54> ;
    edintdimension:contractType edintcontracttype:permanent ;

    # --- medidas ---
    edintmeasure:activePopulationCount       125000 ;
    edintmeasure:employedPopulationCount     110000 ;
    edintmeasure:unemployedPopulationCount   15000 ;
    edintmeasure:registeredContractsCount    12000 ;
    edintmeasure:jobSeekersCount             15000 ;
    edintmeasure:registeredUnemploymentCount 14500 ;
    edintmeasure:socialSecurityAffiliatesCount 118000 ;
    ine:unemploymentRate                     12.0 ;
    ine:employmentRate                       55.0 ;
    ine:jobs                                108000 ;
    edintmeasure:jobProfiles                "ingeniero;tecnico;administrativo" ;
    ine:numberOfPeople                      200000 .

